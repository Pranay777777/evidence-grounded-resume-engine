# Copy to .env and fill in. NEVER commit .env.
APP_ENV=local
LOG_LEVEL=INFO

# Example service config
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app

# Example third-party key — use a test/sandbox key locally
EXAMPLE_API_KEY=

# Embedding model for retrieval (ADR-004). bge-small needs: pip install -e ".[embeddings]"
# and downloads ~67 MB on first use. hashing needs nothing (a lexical baseline).
EMBEDDER=bge-small

# Generation (ADR-007). A free key from https://openrouter.ai/keys. On free
# models the provider may log prompts — keep confidential detail out of evidence.
OPENROUTER_API_KEY=
# Default: the free router. Pin a model for evals: python -m grounded.generation models
LLM_MODEL=openrouter/free
# Other providers use a prefix (ADR-012): ollama:<model> (local, no key) or openai:<model>.
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
PROMPT_VERSION=generate-v2
LLM_MAX_TOKENS=2000

# Privacy (ADR-015): redaction before any non-local provider; LOCAL_ONLY refuses remote specs.
REDACTION=patterns
REDACT_TERMS=
LOCAL_ONLY=false

# Generation API (ADR-016). Create keys with: python -m grounded.api keygen <name>
API_KEYS=
RATE_LIMIT=10/minute

# Auth and tenancy (ADR-017). AUTH=jwt needs a JWT_SECRET of 32+ bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH=off
# JWT_SECRET=

# Traces (ADR-018): none | console | otlp (reads OTEL_EXPORTER_OTLP_ENDPOINT).
OTEL_EXPORTER=none
# Semantic cache (ADR-013), set from `make cache-bench`.
CACHE_THRESHOLD=0.90

# Entailment verifier (ADR-009). Set the threshold from `make calibrate`.
VERIFIER_THRESHOLD=0.95
